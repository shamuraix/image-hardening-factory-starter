import groovy.json.JsonSlurperClassic


def parameterText(String name) {
    def value = params[name]
    return value == null ? '' : value.toString().trim()
}


def safeName(String value) {
    return value.replaceAll(/[^A-Za-z0-9_.-]/, '-').take(120)
}


def snapshotArtifact(String family) {
    return safeName("${family}-snapshot-${env.BUILD_NUMBER}-${env.JOB_NAME}")
}


def requiredSetting(String name) {
    def value = env[name]?.trim()
    if (!value) {
        error("Jenkins setting ${name} is required")
    }
    return value
}


def requiredRunnerImage(String name) {
    def value = requiredSetting(name)
    if (!(value ==~ /.+@sha256:[0-9a-f]{64}$/)) {
        error("Jenkins setting ${name} must be a digest-qualified OCI image reference")
    }
    return value
}


def mirrorCredentials() {
    return [
        usernamePassword(
            credentialsId: requiredSetting('SCM_MIRROR_CREDENTIAL_ID'),
            usernameVariable: 'SCM_MIRROR_USERNAME',
            passwordVariable: 'SCM_MIRROR_TOKEN',
        ),
    ]
}


def intakeCredentials() {
    return [
        string(
            credentialsId: requiredSetting('ARTIFACTORY_INTAKE_WRITE_CREDENTIAL_ID'),
            variable: 'ARTIFACTORY_WRITE_TOKEN',
        ),
        file(
            credentialsId: requiredSetting('COSIGN_INTAKE_KEY_CREDENTIAL_ID'),
            variable: 'COSIGN_INTAKE_KEY_REF',
        ),
        string(
            credentialsId: requiredSetting('COSIGN_INTAKE_PASSWORD_CREDENTIAL_ID'),
            variable: 'COSIGN_PASSWORD',
        ),
        file(
            credentialsId: requiredSetting('COSIGN_INTAKE_PUBLIC_KEY_CREDENTIAL_ID'),
            variable: 'COSIGN_INTAKE_PUBLIC_KEY',
        ),
    ]
}


def inIntakePod(String stageName, Closure body) {
    podTemplate(
        inheritFrom: requiredSetting('FACTORY_K8S_INTAKE_POD_TEMPLATE'),
        containers: [
            containerTemplate(
                name: 'factory',
                image: requiredRunnerImage('FACTORY_INTAKE_RUNNER_IMAGE'),
                alwaysPullImage: true,
                command: 'sleep',
                args: '99d',
                ttyEnabled: true,
            ),
        ],
    ) {
        node(POD_LABEL) {
            container('factory') {
                deleteDir()
                def scmState = checkout(scm)
                def catalogDirectory = env.FACTORY_CATALOG_DIR?.trim() ?: 'catalog/images'
                def buildIdentity = safeName(
                    "${env.BUILD_NUMBER}-${env.JOB_NAME}-${scmState.GIT_COMMIT ?: ''}"
                )
                withEnv([
                    "PYTHONPATH=${pwd()}",
                    "FACTORY_CATALOG_DIR=${catalogDirectory}",
                    "FACTORY_WORKSPACE=${pwd()}",
                    "FACTORY_BUILD_ID=${buildIdentity}",
                    "FACTORY_BUILD_URL=${env.BUILD_URL ?: ''}",
                    "FACTORY_COMMIT_SHA=${scmState.GIT_COMMIT ?: env.GIT_COMMIT ?: ''}",
                    "FACTORY_SOURCE_URL=${scmState.GIT_URL ?: env.GIT_URL ?: ''}",
                    "FACTORY_RUNNER_ID=${env.NODE_NAME}",
                    "FACTORY_JOB_ID=${safeName("${buildIdentity}-${stageName}")}",
                    'HOME=/home/factory',
                    'XDG_RUNTIME_DIR=/tmp/factory-runtime',
                ]) {
                    sh 'mkdir -p work/intake "${XDG_RUNTIME_DIR}" && chmod 0700 "${XDG_RUNTIME_DIR}"'
                    body()
                }
            }
        }
    }
}


properties([
    buildDiscarder(logRotator(numToKeepStr: '10')),
    disableConcurrentBuilds(),
    parameters([
        string(
            name: 'FACTORY_CHANGED_IMAGES',
            defaultValue: '',
            description: 'Comma-separated catalog roots; empty selects all images',
        ),
    ]),
])

[
    'FACTORY_SOURCE_REPOSITORY',
    'UPSTREAM_OCI_REPOSITORY',
    'INTERNAL_GIT_BASE_URL',
    'ARTIFACTORY_URL',
    'ARTIFACTORY_REGISTRY',
].each { requiredSetting(it) }

def plan
stage('plan') {
    inIntakePod('plan') {
        withEnv(["FACTORY_CHANGED_IMAGES=${parameterText('FACTORY_CHANGED_IMAGES')}"]) {
            sh 'scripts/render_jenkins_plan.sh generated-jenkins-plan.json'
        }
        def planText = readFile('generated-jenkins-plan.json')
        plan = new JsonSlurperClassic().parseText(planText)
        archiveArtifacts artifacts: 'generated-jenkins-plan.json', fingerprint: true
    }
}

stage('mirror sources') {
    inIntakePod('mirror-sources') {
        withCredentials(mirrorCredentials()) {
            sh 'scripts/mirror_sources.sh'
        }
    }
}

stage('resolve and publish resource locks') {
    def branches = [:]
    plan.images.each { definition ->
        def image = definition.name as String
        branches[image] = {
            inIntakePod("intake-${image}") {
                withCredentials(intakeCredentials()) {
                    withEnv(["FACTORY_IMAGE=${image}"]) {
                        sh '''
                            catalog="${FACTORY_CATALOG_DIR}/${FACTORY_IMAGE}.yaml"
                            mirror=$(yq -r '.source.mirrorPath' "${catalog}")
                            revision=$(yq -r '.source.revision' "${catalog}")
                            mkdir -p "work/${FACTORY_IMAGE}"
                            git clone --no-checkout \
                              "${INTERNAL_GIT_BASE_URL%/}/${mirror}.git" \
                              "work/${FACTORY_IMAGE}/source"
                            git -C "work/${FACTORY_IMAGE}/source" checkout --detach "${revision}"
                            python3 -m factory.cli intake \
                              --image "${catalog}" \
                              --source-dir "work/${FACTORY_IMAGE}/source" \
                              --cache-dir "work/${FACTORY_IMAGE}/cache" \
                              --output "work/${FACTORY_IMAGE}/resource-lock.json"
                            scripts/publish_intake.sh "${FACTORY_IMAGE}"
                        '''
                    }
                }
                archiveArtifacts(
                    artifacts: "work/${image}/resource-lock.json,work/${image}/resource-lock.sig",
                    fingerprint: true,
                )
            }
        }
    }
    parallel(branches)
}
