{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make validate)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make ci)",
      "Bash(make tekton-render)",
      "Bash(make tekton-check)",
      "Bash(make policy-test)",
      "Bash(make agents)",
      "Bash(python3 -m factory.cli *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(jq *)",
      "Bash(yq *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(kubectl apply *)",
      "Bash(tkn *)"
    ],
    "deny": [
      "Read(./**/*.key)",
      "Read(./**/cosign.key)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(cosign sign *)",
      "Bash(cosign attest *)",
      "Bash(kubectl delete *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-paths.sh",
            "args": []
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/render-reminder.sh",
            "args": []
          }
        ]
      }
    ]
  }
}
