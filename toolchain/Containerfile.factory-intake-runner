# Intake runner: the factory runner, run only by the connected tasks — intake
# (mirror sources, publish signed locks), security-data (download scanner
# databases and the CISA KEV catalog), and the upstream-sync reconnaissance.
#
# Every tool these tasks use is already in the runner; this image exists so the
# connected trust class runs from its own digest-pinned image (Repository CR
# param `intake_runner_image`). It runs only with the intake ServiceAccount and
# never on pull requests.
ARG FACTORY_RUNNER_REF
FROM ${FACTORY_RUNNER_REF}

RUN for tool in trivy osv-scanner grype cosign skopeo; do \
      command -v "${tool}" >/dev/null || { echo "missing tool: ${tool}" >&2; exit 1; }; \
    done
USER 10001
ENTRYPOINT []
CMD ["/bin/bash"]
