# Factory runner: the image every pipeline step runs in (except the agent
# steps, which use Containerfile.factory-agent layered on this one, and the
# connected security-data and intake tasks, which use
# Containerfile.factory-intake-runner layered on this one).
#
# Inputs, produced by `make toolchain` (toolchain/download-tools.py and a wheel
# of this repository), are copied in; nothing is downloaded while building:
#   dist/tools/         pinned static binaries (tools/versions.lock.yaml)
#   dist/rpms/          the ClamAV package (not in the UBI repositories)
#   dist/factory-wheel/ this repository and its Python dependencies
#   dist/ca-trust/      optional extra CA certificates (*.crt, PEM) to trust,
#                       such as a TLS-inspecting proxy's root; see
#                       FACTORY_CA_BUNDLE in toolchain/build-dist.sh
#
# BASE_REF is the UBI 9 minimal image: the internal hardened base in production,
# registry.access.redhat.com/ubi9/ubi-minimal in the kind harness.
ARG BASE_REF
FROM ${BASE_REF}

ARG FACTORY_UID=10001
ARG FACTORY_GID=10001
COPY dist/tools/ /usr/local/bin/
COPY dist/rpms/ /tmp/rpms/
COPY dist/factory-wheel/ /tmp/wheels/
COPY dist/ca-trust/ /tmp/ca-trust/

# Extra CA certificates must be trusted before the first network access below.
# The probe that follows fails with a plain explanation when the UBI CDN is
# unreachable over TLS, which behind an inspecting proxy means the proxy's root
# is missing from dist/ca-trust/ (FACTORY_CA_BUNDLE).
RUN if ls /tmp/ca-trust/*.crt >/dev/null 2>&1; then \
      echo "trusting extra CA certificates:" && ls /tmp/ca-trust/ \
      && cp /tmp/ca-trust/*.crt /etc/pki/ca-trust/source/anchors/ && update-ca-trust; \
    else echo "no extra CA certificates"; fi \
    && rm -rf /tmp/ca-trust
RUN if ! curl -fsS -o /dev/null https://cdn-ubi.redhat.com/content/public/ubi/dist/ubi9/9/x86_64/baseos/os/repodata/repomd.xml; then \
      echo "cannot reach cdn-ubi.redhat.com over TLS from inside the build." >&2; \
      echo "Behind a TLS-inspecting proxy, export its root certificate and set FACTORY_CA_BUNDLE (docs/local-kubernetes-testing.md)." >&2; \
      curl -sS -o /dev/null https://cdn-ubi.redhat.com/ >&2 || true; \
      exit 1; \
    fi

# UBI 9 AppStream/BaseOS packages: Python 3.12 (the system python3 is 3.9),
# rootless Podman with its user-namespace helpers, Skopeo, OpenSCAP, git, jq.
# curl is already present as curl-minimal (installing "curl" conflicts with it).
RUN microdnf install -y --setopt=install_weak_deps=0 \
      python3.12 python3.12-pip git-core jq tar gzip \
      podman skopeo slirp4netns fuse-overlayfs shadow-utils-subid openscap-scanner \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python3 \
    && ln -sf /usr/bin/pip3.12 /usr/local/bin/pip3 \
    && python3 -m pip install --no-cache-dir --no-index --find-links /tmp/wheels 'image-hardening-factory[dev]' \
    && rpm -i /tmp/rpms/clamav-*.rpm \
    && chmod 0555 /usr/local/bin/* \
    && for tool in buildctl buildkitd buildkit-runc rootlesskit umoci cosign oras \
         syft grype trivy osv-scanner yq opa clamscan; do \
         test -x "/usr/local/bin/${tool}" || { echo "missing tool: ${tool}" >&2; exit 1; }; \
       done \
    && python3 -c 'import factory.cli' \
    && printf 'factory:x:%s:\n' "${FACTORY_GID}" >>/etc/group \
    && printf 'factory:x:%s:%s:Image Factory:/home/factory:/bin/bash\n' \
      "${FACTORY_UID}" "${FACTORY_GID}" >>/etc/passwd \
    && printf 'factory:100000:65536\n' >>/etc/subuid \
    && printf 'factory:100000:65536\n' >>/etc/subgid \
    && test -u /usr/bin/newuidmap \
    && test -u /usr/bin/newgidmap \
    && test -x /usr/bin/slirp4netns \
    && install -d -m 0700 -o "${FACTORY_UID}" -g "${FACTORY_GID}" \
      /home/factory /home/factory/.config /home/factory/.config/containers \
      /home/factory/.local/share/containers /tmp/factory-runtime \
    && microdnf clean all \
    && rm -rf /tmp/wheels /tmp/rpms /var/cache/dnf

COPY --chown=${FACTORY_UID}:${FACTORY_GID} toolchain/storage.conf /home/factory/.config/containers/storage.conf

ENV HOME=/home/factory \
    XDG_RUNTIME_DIR=/tmp/factory-runtime \
    CONTAINERS_STORAGE_CONF=/home/factory/.config/containers/storage.conf \
    STORAGE_DRIVER=vfs
USER ${FACTORY_UID}
ENTRYPOINT []
CMD ["/bin/bash"]
