FROM docker.io/library/debian:bookworm-slim
ARG FACTORY_SUBUID_START=100000
ARG FACTORY_SUBUID_COUNT=65536
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates curl git jq python3 python3-yaml python3-jsonschema \
    skopeo podman uidmap slirp4netns openssl tar gzip xz-utils procps \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 factory \
    && useradd --uid 10001 --gid 10001 --create-home --shell /bin/bash factory \
    && printf 'factory:%s:%s\n' "${FACTORY_SUBUID_START}" "${FACTORY_SUBUID_COUNT}" >/etc/subuid \
    && printf 'factory:%s:%s\n' "${FACTORY_SUBUID_START}" "${FACTORY_SUBUID_COUNT}" >/etc/subgid
COPY configure-uidmap.py /tmp/configure-uidmap.py
RUN python3 /tmp/configure-uidmap.py && rm /tmp/configure-uidmap.py
COPY tools/ /usr/local/bin/
COPY ca.crt /usr/local/share/ca-certificates/factory-review.crt
RUN update-ca-certificates && chmod 0555 /usr/local/bin/* \
    && mkdir -p /home/factory/.config/containers /home/factory/.local/share/containers /tmp/factory-runtime \
    && chown -R 10001:10001 /home/factory /tmp/factory-runtime \
    && printf '[storage]\ndriver="vfs"\nrunroot="/tmp/factory-runtime/storage"\ngraphroot="/home/factory/.local/share/containers/storage"\n' \
       >/home/factory/.config/containers/storage.conf \
    && printf '[containers]\ndefault_sysctls=[]\n' >/home/factory/.config/containers/containers.conf
# Nested offline containers do not need Podman's default ping-group sysctl;
# writing it fails against the Kubernetes container's read-only /proc/sys.
ENV HOME=/home/factory XDG_RUNTIME_DIR=/tmp/factory-runtime STORAGE_DRIVER=vfs
USER 10001
CMD ["sleep", "99d"]
