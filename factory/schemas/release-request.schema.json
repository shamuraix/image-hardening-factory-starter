{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:image-hardening-factory:schema:release-request:v1alpha1",
  "title": "ReleaseRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "candidate", "evidence"],
  "properties": {
    "apiVersion": {"const": "image-hardening-factory/v1alpha1"},
    "kind": {"const": "ReleaseRequest"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "environment"],
      "properties": {
        "image": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "environment": {"enum": ["commercial", "gov1", "gov2"]},
        "requestedBy": {"type": "string"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "productVersion", "sourceRevision", "factoryRevision"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[a-z0-9.-]+(:[0-9]+)?/[a-z0-9._/-]+$"},
        "tag": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "productVersion": {"type": "string"},
        "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "factoryRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "pipelineRun": {"type": "string"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestDigest", "sha256"],
      "properties": {
        "manifestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {"const": true},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
