{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:image-hardening-factory:schema:hardened-image:v1alpha1",
  "title": "HardenedImage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "source",
    "product",
    "build",
    "policy",
    "publication"
  ],
  "properties": {
    "apiVersion": {
      "const": "image-hardening-factory/v1alpha1"
    },
    "kind": {
      "const": "HardenedImage"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "track"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]+$"
        },
        "track": {
          "enum": [
            "release",
            "canary"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream",
        "mirrorPath",
        "revision",
        "containerfile",
        "hardeningManifest"
      ],
      "properties": {
        "upstream": {
          "type": "string",
          "format": "uri"
        },
        "mirrorPath": {
          "type": "string",
          "pattern": "^[a-z0-9_./-]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "containerfile": {
          "type": "string"
        },
        "hardeningManifest": {
          "type": "string"
        },
        "overlay": {
          "type": "string"
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "vendor",
        "license"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platforms",
        "network",
        "base"
      ],
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "linux/amd64",
              "linux/arm64"
            ]
          },
          "maxItems": 1
        },
        "network": {
          "const": "internal-only"
        },
        "base": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "lockKey"
              ],
              "properties": {
                "kind": {
                  "const": "upstream"
                },
                "lockKey": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "image"
              ],
              "properties": {
                "kind": {
                  "const": "catalog"
                },
                "image": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]+$"
                }
              }
            }
          ]
        },
        "rpm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "enum": [
                "private-mirror",
                "public-upstream"
              ]
            }
          }
        },
        "buildArgs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumDatabaseAgeHours",
        "block"
      ],
      "properties": {
        "maximumDatabaseAgeHours": {
          "type": "integer",
          "minimum": 1
        },
        "block": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "knownExploited",
            "critical",
            "fixableHigh",
            "newHigh"
          ],
          "properties": {
            "knownExploited": {
              "type": "boolean"
            },
            "critical": {
              "type": "boolean"
            },
            "fixableHigh": {
              "type": "boolean"
            },
            "newHigh": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quarantineRepository",
        "releaseRepository",
        "imagePath"
      ],
      "properties": {
        "quarantineRepository": {
          "type": "string"
        },
        "releaseRepository": {
          "type": "string"
        },
        "imagePath": {
          "type": "string"
        }
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "description": "Static expectations checked by the context-check and image-check stages; nothing runs the image.",
      "required": [
        "profile",
        "sources",
        "runUser",
        "runUid",
        "ports",
        "entrypoint",
        "cmd",
        "homeEnv",
        "installDirEnv"
      ],
      "properties": {
        "profile": {
          "enum": [
            "jira",
            "confluence",
            "bitbucket"
          ]
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entrypoint",
            "helpers"
          ],
          "properties": {
            "entrypoint": {
              "type": "string"
            },
            "helpers": {
              "type": "string"
            },
            "templates": {
              "type": "string"
            }
          }
        },
        "runUser": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]*$"
        },
        "runUid": {
          "type": "integer",
          "minimum": 1
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "entrypoint": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cmd": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "homeEnv": {
          "type": "string"
        },
        "installDirEnv": {
          "type": "string"
        },
        "requiredPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "forbiddenPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "envPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "ENV variables whose value must resolve to a path in the image"
        }
      }
    }
  }
}
